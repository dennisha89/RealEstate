# =============================================================================
# RealEstate Intelligence Platform - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your API keys
# cp .env.example .env.local
# =============================================================================

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Property Data APIs (P0 - Must Have) ---
ATTOM_API_KEY=                    # https://api.gateway.attomdata.com - Property details, sales history
RENTCAST_API_KEY=                 # https://api.rentcast.io - Rental estimates, rental comps
CENSUS_API_KEY=                   # https://api.census.gov - Demographics, income, migration

# --- Economic Data APIs (P1 - High Priority) ---
FRED_API_KEY=                     # https://api.stlouisfed.org - Mortgage rates, CPI, GDP, home prices
BLS_API_KEY=                      # https://api.bls.gov - Employment, unemployment, wages
WALKSCORE_API_KEY=                # https://www.walkscore.com/professional - Walk/transit/bike scores
GREATSCHOOLS_API_KEY=             # https://www.greatschools.org/api - School ratings

# --- Enhanced Data (P2 - Medium Priority) ---
BRIGHT_DATA_API_KEY=              # https://brightdata.com - Zillow/Redfin/Realtor.com scraping
CLIMATECHECK_API_KEY=             # https://climatecheck.com - Property-level climate risk
AIRDNA_API_KEY=                   # https://www.airdna.co - Short-term rental performance

# --- Maps & Geocoding ---
NEXT_PUBLIC_MAPBOX_TOKEN=         # https://mapbox.com - Interactive maps, geocoding
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY= # Google Places - Address autocomplete

# --- AI Analysis ---
ANTHROPIC_API_KEY=                # https://console.anthropic.com - Claude AI analysis engine

# --- Caching ---
REDIS_URL=                        # Redis connection string (redis://localhost:6379)

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
